generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ARCHITECT
  SUPERVISOR
  COLLABORATOR
  RESPONSIBLE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  DESIGN
  REVIEW
  QUOTING
  APPROVED
  CUTTING_LIST
  PRODUCTION
  INSTALLATION
  CLOSED
  ARCHIVED
}

enum DesignStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  OUTDATED
}

enum RenderStatus {
  PRELIMINARY
  FINAL
  APPROVED
  REJECTED
}

enum CuttingListStatus {
  DRAFT
  PENDING_VALIDATION
  AUTHORIZED
  REJECTED
  OUTDATED
}

enum QuoteStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
  CANCELED
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentType {
  MEASUREMENTS
  QUOTE
  CONTRACT
  CUTTING_LIST
  PLAN
  RENDER
  DELIVERY_CERTIFICATE
  OTHER
}

enum MaterialUnit {
  BOARD
  SHEET
  LINEAR_METER
  SQUARE_METER
  PIECE
}

enum HistoryAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  APPROVED
  REJECTED
  ARCHIVED
  COMMENTED
  DOCUMENT_UPLOADED
}

enum CommentTargetType {
  PROJECT
  DESIGN
  DESIGN_MODULE
  RENDER
  CUTTING_LIST
  QUOTE
  ACTIVITY
  DOCUMENT
}

model Person {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  address   String?
  email     String?  @unique
  rfc       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?
  client Client?
}

model User {
  id           String   @id @default(cuid())
  personId     String?  @unique
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  person             Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdProjects    Project[]      @relation("ProjectCreatedBy")
  assignedActivities Activity[]     @relation("ActivityAssignee")
  savedRenders       Render[]       @relation("RenderCreatedBy")
  generatedLists     CuttingList[]  @relation("CuttingListGeneratedBy")
  validatedLists     CuttingList[]  @relation("CuttingListValidatedBy")
  quotes             Quote[]        @relation("QuoteCreatedBy")
  alerts             Alert[]        @relation("AlertCreatedBy")
  documents          Document[]     @relation("DocumentUploadedBy")
  historyEntries     HistoryEntry[]
  comments           Comment[]

  @@index([role])
  @@index([isActive])
}

model Client {
  id                 String       @id @default(cuid())
  personId           String       @unique
  projectAddress     String?
  initialContactDate DateTime?
  status             ClientStatus @default(ACTIVE)
  notes              String?
  consentAcceptedAt  DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([status])
}

model Project {
  id             String        @id @default(cuid())
  clientId       String
  createdById    String?
  name           String
  description    String?
  location       String?
  status         ProjectStatus @default(DRAFT)
  startDate      DateTime      @default(now())
  deliveryDate   DateTime?
  closedAt       DateTime?
  archivedAt     DateTime?
  roomSpaceJson  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client         Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy      User?          @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  designs        Design[]
  renders        Render[]
  cuttingLists   CuttingList[]
  quotes         Quote[]
  activities     Activity[]
  alerts         Alert[]
  documents      Document[]
  historyEntries HistoryEntry[]
  comments       Comment[]

  @@index([clientId])
  @@index([status])
  @@index([deliveryDate])
}

model Design {
  id            String       @id @default(cuid())
  projectId     String
  createdById   String?
  approvedById  String?
  title         String
  version       Int          @default(1)
  status        DesignStatus @default(DRAFT)
  isCurrent     Boolean      @default(true)
  roomSpaceJson String?
  designJson    String       @default("{}")
  notes         String?
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modules DesignModule[]
  renders Render[]
  cuttingLists CuttingList[]
  comments Comment[]

  @@unique([projectId, version])
  @@index([projectId, isCurrent])
  @@index([status])
}

model DesignModule {
  id          String   @id @default(cuid())
  designId    String
  templateId  String?
  materialId  String?
  name        String
  kind        String
  positionXmm Float    @default(0)
  positionYmm Float    @default(0)
  positionZmm Float    @default(0)
  rotationX   Float    @default(0)
  rotationY   Float    @default(0)
  rotationZ   Float    @default(0)
  widthMm     Float
  heightMm    Float
  depthMm     Float
  quantity    Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  design   Design          @relation(fields: [designId], references: [id], onDelete: Cascade)
  template ModuleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  material Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  comments Comment[]

  @@index([designId])
  @@index([templateId])
  @@index([materialId])
}

model ModuleTemplate {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  category          String
  defaultWidthMm    Float
  defaultHeightMm   Float
  defaultDepthMm    Float
  parameterJson     String   @default("{}")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  modules DesignModule[]

  @@index([category])
  @@index([isActive])
}

model Material {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  category    String
  unit        MaterialUnit @default(SHEET)
  cost        Float        @default(0)
  thicknessMm Float?
  colorHex    String?
  texturePath String?
  supplier    String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules       DesignModule[]
  cuttingPieces CuttingPiece[]
  quoteItems    QuoteItem[]

  @@index([category])
  @@index([isActive])
}

model Render {
  id               String       @id @default(cuid())
  projectId        String
  designId         String?
  createdById      String?
  title            String
  version          Int          @default(1)
  status           RenderStatus @default(PRELIMINARY)
  filePath         String?
  thumbnailPath    String?
  format           String
  resolutionWidth  Int
  resolutionHeight Int
  sizeMb           Float?
  viewType         String?
  cameraAngle      String?
  quality          String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  design    Design? @relation(fields: [designId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("RenderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
}

model CuttingList {
  id            String            @id @default(cuid())
  projectId     String
  designId      String?
  generatedById String?
  validatedById String?
  version       Int               @default(1)
  status        CuttingListStatus @default(DRAFT)
  notes         String?
  exportPath    String?
  authorizedAt  DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  design      Design?        @relation(fields: [designId], references: [id], onDelete: SetNull)
  generatedBy User?          @relation("CuttingListGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  validatedBy User?          @relation("CuttingListValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  pieces      CuttingPiece[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
}

model CuttingPiece {
  id            String   @id @default(cuid())
  cuttingListId String
  materialId    String?
  name          String
  widthMm       Float
  heightMm      Float
  depthMm       Float?
  thicknessMm   Float?
  quantity      Int      @default(1)
  grainDirection String?
  edgeBanding   String?
  comments      String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cuttingList CuttingList @relation(fields: [cuttingListId], references: [id], onDelete: Cascade)
  material    Material?   @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([cuttingListId])
  @@index([materialId])
}

model Quote {
  id             String      @id @default(cuid())
  projectId      String
  createdById    String?
  version        Int         @default(1)
  status         QuoteStatus @default(DRAFT)
  subtotal       Float       @default(0)
  taxRate        Float       @default(0.16)
  taxAmount      Float       @default(0)
  laborCost      Float       @default(0)
  discountAmount Float       @default(0)
  advancePayment Float       @default(0)
  total          Float       @default(0)
  notes          String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     QuoteItem[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  materialId  String?
  description String
  quantity    Float
  unit        String
  unitPrice   Float
  total       Float
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quote    Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([materialId])
}

model Activity {
  id             String         @id @default(cuid())
  projectId      String
  assignedToId   String?
  title          String
  description    String?
  stage          String?
  status         ActivityStatus @default(PENDING)
  priority       AlertPriority  @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("ActivityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  alerts     Alert[]

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model Alert {
  id          String        @id @default(cuid())
  projectId   String?
  activityId  String?
  createdById String?
  title       String
  message     String
  priority    AlertPriority @default(MEDIUM)
  isRead      Boolean       @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity  Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([priority])
  @@index([isRead])
  @@index([resolvedAt])
}

model Document {
  id          String       @id @default(cuid())
  projectId   String
  uploadedById String?
  title       String
  fileName    String
  filePath    String
  mimeType    String?
  fileSize    Int?
  documentType DocumentType @default(OTHER)
  stage       String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  comments   Comment[]

  @@index([projectId])
  @@index([documentType])
}

model HistoryEntry {
  id          String        @id @default(cuid())
  projectId   String
  userId      String?
  action      HistoryAction
  entityType  String
  entityId    String?
  title       String
  description String?
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([action])
  @@index([createdAt])
}

model Comment {
  id          String            @id @default(cuid())
  projectId   String
  designId    String?
  moduleId    String?
  documentId  String?
  userId      String?
  targetType  CommentTargetType
  targetId    String?
  body        String
  isResolved  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  design   Design?       @relation(fields: [designId], references: [id], onDelete: SetNull)
  module   DesignModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  document Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([targetType, targetId])
  @@index([isResolved])
}
